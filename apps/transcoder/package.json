    "@repo/events": "workspace:*",
    "@repo/shared": "workspace:*",
    "amqplib": "^0.10.3",
    "bullmq": "^5.0.0",
    "dotenv": "^17.2.3",
    "fluent-ffmpeg": "^2.1.2",
    "ioredis": "^5.3.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/amqplib": "^0.10.1",
    "@types/dotenv": "^8.2.3",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
